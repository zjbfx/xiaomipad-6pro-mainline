# Local build inputs, outputs and logs (including symlinks to shared caches).
/out
/tools/local
/sources
/logs

# Python and editor state.
__pycache__/
*.pyc
*.swp
*~

# Add documentation images explicitly after review.
*.jpg
*.jpeg
*.png
*.heic

# ...but the boot splash's artwork is a build input, not a screenshot: the theme
# is useless without it, so it is tracked.  Regenerate with
# tools/make-liuqin-plymouth-watermark.sh.
!device/gnome-overlay/usr/share/plymouth/themes/liuqin/watermark.png
